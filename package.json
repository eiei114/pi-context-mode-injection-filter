{
  "name": "pi-context-mode-injection-filter",
  "version": "0.1.2",
  "description": "Pi extension that prevents context-mode's synthetic routing message from superseding the latest user request.",
  "type": "module",
  "license": "MIT",
  "author": "Keisu",
  "keywords": [
    "pi-package",
    "pi",
    "context-mode",
    "provider-payload",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eiei114/pi-context-mode-injection-filter"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-context-mode-injection-filter/issues"
  },
  "homepage": "https://github.com/eiei114/pi-context-mode-injection-filter#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check && npm run publish:guard",
    "pack:check": "npm pack --dry-run",
    "publish:guard": "node scripts/check-no-npm-token.mjs",
    "version:check": "node scripts/check-version-bump.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
